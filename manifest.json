{
    "manifest_version": 3,
    "name": "Moodle PDF Downloader",
    "version": "1.3.1",
    "description": "Scans the current Moodle course page for PDF links and video recordings, and lists them for download.",
    "author": "Idan Vaknin",
    "permissions": [
        "activeTab",
        "scripting",
        "downloads",
        "storage",
        "tabs"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "host_permissions": [
        "*://lemida.biu.ac.il/course/*",
        "*://*/mod/resource/view.php?id=*",
        "*://lemida.biu.ac.il/blocks/video/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://lemida.biu.ac.il/course/*",
                "*://*/mod/resource/view.php?id=*",
                "*://lemida.biu.ac.il/blocks/video/*"
            ],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}

